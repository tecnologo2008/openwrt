From: GL.iNet Test Build <support@gl-inet.com>
Subject: [PATCH] net: mediatek: integrate RTL8366UB PPE offload

Integrate the RTL8366UB 802.1Q DSA tagger with MediaTek Ethernet and
PPE output selection. Substitute the conduit for DSA user devices,
use internal management VIDs for standalone and VLAN-unaware paths,
and retain the business VID without an outer management tag for
VLAN-aware forwarding. Reject unsupported VLAN-aware encapsulations.

Besides the MediaTek Ethernet and PPE code, this also changes the generic
netfilter flowtable path code (net/netfilter/nf_flow_table_path.c): it
preserves the bridge-resolved business VLAN in flowtable paths,
including untagged user-port egress and routing through a bridge PVID.
nft_dev_path_info() jumps to the common bridge bookkeeping afterwards, so
these flows still get the fdb-move teardown.

The RTL8366UB tagger uses plain 802.1Q tags, so the MediaTek special
tag parser (GDMA special tag, and TX_DMA_SPTAG_V3 on NETSYS v3) must be
off for it. The existing behaviour is deliberately kept for every other
DSA tagger, so boards using RTL8365MB, MxL862xx and similar taggers are
not affected by this change.

Apply after the RTL8366UB switch and tagger patch (980-01), and after the YT922x
PPE patches (967-xx) whose mtk_flow_get_dsa_port() changes it builds on.

---
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
index 221ce72d2..887c4d0e1 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -1615,7 +1615,8 @@ static void mtk_tx_set_dma_desc_v2(struct net_device *dev, void *txd,
 		/* tx checksum offload */
 		if (info->csum)
 			data |= TX_DMA_CHKSUM_V2;
-		if (mtk_is_netsys_v3_or_greater(eth) && netdev_uses_dsa(dev))
+		if (mtk_is_netsys_v3_or_greater(eth) && netdev_uses_dsa(dev) &&
+		    dev->dsa_ptr->tag_ops->proto != DSA_TAG_PROTO_RTL8366UB_8021Q)
 			data |= TX_DMA_SPTAG_V3;
 	}
 	WRITE_ONCE(desc->txd5, data);
@@ -3795,8 +3796,16 @@ static void mtk_gdm_config(struct mtk_eth *eth, u32 id, u32 config)
 
 	val |= config;
 
-	if (eth->netdev[id] && netdev_uses_dsa(eth->netdev[id]))
-		val |= MTK_GDMA_SPECIAL_TAG;
+	if (eth->netdev[id] && netdev_uses_dsa(eth->netdev[id])) {
+		/* The RTL8366UB tagger uses plain 802.1Q tags, which the
+		 * MediaTek special tag parser must not look at. Every other
+		 * tagger keeps the existing behaviour.
+		 */
+		if (eth->netdev[id]->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_RTL8366UB_8021Q)
+			val &= ~MTK_GDMA_SPECIAL_TAG;
+		else
+			val |= MTK_GDMA_SPECIAL_TAG;
+	}
 
 	mtk_w32(eth, val, MTK_GDMA_FWD_CFG(id));
 }
diff --git a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
index 0c5de6034..0d44eb8da 100644
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -183,16 +183,20 @@ mtk_flow_mangle_ipv4(const struct flow_action_entry *act,
  * the MxL862xx tag_8021q tagger), or the full VLAN TCI for the
  * VLAN-shaped YT922x four-byte port tag.
  *
+ * The RTL8366UB 802.1Q tagger pushes the same kind of management VID
+ * unless its bridge is VLAN-aware. In that case *push_vid is 0 and
+ * *vlan_only is set: the frame carries only its business VLAN.
+ *
  * push_vid may be NULL for callers that only want the idev->conduit
  * substitution (e.g. ingress-side ppe_idx selection, where no VID
- * is to be pushed on the flow entry).
+ * is to be pushed on the flow entry). vlan_only may then be NULL too.
  *
  * Other tag_8021q-based taggers (sja1105, ocelot_8021q, ...) use
  * different tag layers and/or bridge-scoped VIDs; do not extend the
  * switch below to cover them without per-tagger review.
  */
 static int
-mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
+mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid, bool *vlan_only)
 {
 #if IS_ENABLED(CONFIG_NET_DSA)
 	struct dsa_port *dp;
@@ -210,6 +214,20 @@ mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
 		if (push_vid)
 			*push_vid = dsa_tag_8021q_standalone_vid(dp);
 		break;
+	case DSA_TAG_PROTO_RTL8366UB_8021Q:
+		if (push_vid && vlan_only) {
+			struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+			if (br && dsa_port_is_vlan_filtering(dp)) {
+				*push_vid = 0;
+				*vlan_only = true;
+			} else if (br) {
+				*push_vid = dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+			} else {
+				*push_vid = dsa_tag_8021q_standalone_vid(dp);
+			}
+		}
+		break;
 	case DSA_TAG_PROTO_YT922X_4B:
 		/* The software tagger supplies access-port PVIDs. PPE cannot
 		 * reproduce this policy yet, so retain the software path.
@@ -236,11 +254,13 @@ mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
 static int
 mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 			   struct net_device *dev, const u8 *dest_mac,
-			   int *wed_index, u16 *wcid, unsigned int num_tags)
+			   int *wed_index, u16 *wcid, unsigned int num_tags,
+			   const struct mtk_flow_data *data)
 {
 	struct mtk_wdma_info info = {};
 	struct mtk_mac *mac;
 	int pse_port, dsa_port, queue, err;
+	bool vlan_only = false;
 	u16 push_vid = 0;
 
 	if (mtk_flow_get_wdma_info(dev, dest_mac, &info) == 0) {
@@ -268,7 +288,7 @@ mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 		goto out;
 	}
 
-	dsa_port = mtk_flow_get_dsa_port(&dev, &push_vid);
+	dsa_port = mtk_flow_get_dsa_port(&dev, &push_vid, &vlan_only);
 
 	if (dev == eth->netdev[0])
 		pse_port = PSE_GDM1_PORT;
@@ -289,6 +309,17 @@ mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 			err = mtk_foe_entry_set_vlan(eth, foe, push_vid);
 			if (err)
 				return err;
+		} else if (vlan_only) {
+			/* The CPU link must carry the business VID even for an
+			 * untagged user port. Never use the CPU port's PVID or a
+			 * bridge management VID as an implicit fallback. VIDs
+			 * 3072-4095 are reserved for DSA management.
+			 */
+			if (data->vlan.num != 1 || data->pppoe.num ||
+			    data->vlan.vlans[0].proto != htons(ETH_P_8021Q) ||
+			    !data->vlan.vlans[0].id ||
+			    data->vlan.vlans[0].id >= 3072)
+				return -EOPNOTSUPP;
 		} else {
 			mtk_foe_entry_set_dsa(eth, foe, dsa_port);
 		}
@@ -365,7 +396,7 @@ mtk_flow_offload_replace(struct mtk_eth *eth, struct flow_cls_offload *f,
 			 * ppe[mac->ppe_idx]; the lookup misses and the
 			 * flow never binds in HW.
 			 */
-			mtk_flow_get_dsa_port(&idev, NULL);
+			mtk_flow_get_dsa_port(&idev, NULL, NULL);
 			if (mtk_flow_is_valid_idev(eth, idev)) {
 				struct mtk_mac *mac = netdev_priv(idev);
 
@@ -551,7 +582,7 @@ mtk_flow_offload_replace(struct mtk_eth *eth, struct flow_cls_offload *f,
 
 	err = mtk_flow_set_output_device(eth, &foe, odev, data.eth.h_dest,
 					 &wed_index, &wcid,
-					 data.vlan.num + data.pppoe.num);
+					 data.vlan.num + data.pppoe.num, &data);
 	if (err)
 		return err;
 
diff --git a/net/netfilter/nf_flow_table_path.c b/net/netfilter/nf_flow_table_path.c
index a510b7b60..dde196f18 100644
--- a/net/netfilter/nf_flow_table_path.c
+++ b/net/netfilter/nf_flow_table_path.c
@@ -7,6 +7,7 @@
 #include <linux/spinlock.h>
 #include <linux/netfilter/nf_conntrack_common.h>
 #include <linux/netfilter/nf_tables.h>
+#include <net/dsa.h>
 #include <net/ip.h>
 #include <net/inet_dscp.h>
 #include <net/netfilter/nf_tables.h>
@@ -98,6 +99,24 @@ struct nft_forward_info {
 	enum flow_offload_xmit_type xmit_type;
 };
 
+/* RTL8366UB uses the business VLAN, rather than an internal DSA tag, to
+ * classify CPU-originated frames on a VLAN-filtering bridge. Keep that VID
+ * on the CPU link; the switch performs untagging at the user-port egress.
+ */
+static bool
+nft_bridge_vlan_keep_tag(const struct net_device_path_stack *stack, int index)
+{
+	const struct net_device_path *bridge = &stack->path[index];
+	const struct net_device_path *dsa;
+
+	if (!bridge->bridge.vlan_id || index + 1 >= stack->num_paths)
+		return false;
+
+	dsa = &stack->path[index + 1];
+	return dsa->type == DEV_PATH_DSA &&
+	       dsa->dsa.proto == DSA_TAG_PROTO_RTL8366UB_8021Q;
+}
+
 static int nft_dev_path_info(const struct net_device_path_stack *stack,
 			     struct nft_forward_info *info,
 			     unsigned char *ha, struct nf_flowtable *flowtable)
@@ -145,6 +164,26 @@ static int nft_dev_path_info(const struct net_device_path_stack *stack,
 			if (is_zero_ether_addr(info->h_source))
 				memcpy(info->h_source, path->dev->dev_addr, ETH_ALEN);
 
+			if (nft_bridge_vlan_keep_tag(stack, i)) {
+				n = info->num_encaps;
+
+				/* Use the VID resolved by the bridge, including its
+				 * PVID when routing through the bridge itself. An
+				 * untagged destination port may have another PVID.
+				 */
+				if (!n ||
+				    info->encap[n - 1].id != path->bridge.vlan_id ||
+				    info->encap[n - 1].proto != path->bridge.vlan_proto) {
+					if (n >= NF_FLOW_TABLE_ENCAP_MAX)
+						return -1;
+
+					info->encap[n].id = path->bridge.vlan_id;
+					info->encap[n].proto = path->bridge.vlan_proto;
+					info->num_encaps++;
+				}
+				goto bridge_done;
+			}
+
 			switch (path->bridge.vlan_mode) {
 			case DEV_PATH_BR_VLAN_UNTAG_HW:
 				if (info->num_encaps == 0)
@@ -169,6 +208,7 @@ static int nft_dev_path_info(const struct net_device_path_stack *stack,
 			case DEV_PATH_BR_VLAN_KEEP:
 				break;
 			}
+bridge_done:
 			info->bridge_path = 1;
 			info->port_vlans = 0;
 			n = info->num_encaps;
